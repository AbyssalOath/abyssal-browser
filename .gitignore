# ---------------------------------------------------------------
# Build artifacts (all workspace crates) - regenerated by cargo.
# Cargo.lock IS committed on purpose: this workspace ships executables
# (abyssal, abyssal-renderer, sync-server), and Rust's guidance is to
# commit the lockfile for anything that ships a binary.
# ---------------------------------------------------------------
/target/
**/target/

# Release staging output (release.yml creates these in CI; can appear locally)
/dist/
/abyssal-browser-linux-*.tar.gz

# ---------------------------------------------------------------
# Runtime data - recovery codes, encrypted bookmarks, caches.
# Real browser data lives in an OS user-data directory OUTSIDE this
# repo. These paths only show up via the fallback (HOME/APPDATA unset),
# older builds, or a local sync-server run from the repo root.
# ---------------------------------------------------------------
/abyssal-data/
**/abyssal-data/
/sync-server-data/
**/sync-server-data/

# Defensive -- never commit these even if copied in by hand
account.txt
bookmarks.enc
downloads.enc
*.enc

# ---------------------------------------------------------------
# Secrets and credentials of any kind (defensive)
# ---------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
.env
.env.*
*.env
**/secrets/
credentials.json
credentials.txt

# ---------------------------------------------------------------
# Editors, OS files, local tooling
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.claude/settings.local.json

# ---------------------------------------------------------------
# Rust tooling, profiling, crash and log output
# ---------------------------------------------------------------
*.rs.bk
*.pdb
perf.data*
flamegraph.svg
*.profraw
*.profdata
*.log
/core
core.[0-9]*
vgcore.*

# cargo-fuzz output (for when fuzz targets get added)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# ---------------------------------------------------------------
# packaging/macos/build_app.sh output - regenerable app bundle
# ---------------------------------------------------------------
/Abyssal Browser.app/
